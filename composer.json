{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "elmo-tech/ecommerce-v2-api",
  "type": "project",
  "description": "E-commerce SaaS V2 API - F0-01 Laravel foundation",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "laravel/framework": "^13.0"
  },
  "require-dev": {
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0",
    "laravel/pint": "1.32.3",
    "phpstan/phpstan": "2.3.7",
    "larastan/larastan": "3.15.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
